Cell[3921, 115, 392, 8, 56, "Text",ExpressionUUID->"6ffd851d-a1dd-4004-8511-b77c14ead587"],
Cell[4316, 125, 331, 8, 48, "Input",ExpressionUUID->"11aac063-a435-42a3-ad28-6223ca47090a"],
Cell[4650, 135, 173, 3, 34, "Text",ExpressionUUID->"f2a09e3d-c964-4996-8a75-02d92e625232"]
}, Open  ]],
Cell[CellGroupData[{
Cell[4860, 143, 116, 0, 67, "Section",ExpressionUUID->"2d07f976-feca-4abf-b020-aa1336b16c3d"],
