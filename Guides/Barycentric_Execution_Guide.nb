Notebook[{

Cell[CellGroupData[{
Cell["Barycentric Dynamic Symmetries", "Title",ExpressionUUID->"303d83a4-8d02-45a0-ae9d-7d1473bd67b3"],

Cell["A guided Mathematica execution notebook", "Subtitle",
 CellChangeTimes->{{4.003986204456776*^9, 
  4.0039862068409324`*^9}},ExpressionUUID->"82de779b-aefd-4eb6-bc7e-\
8dfdb98329c2"],

Cell["\<\
This notebook accompanies the research project on barycentric observers, \
changing graph automorphisms, and exact motif-based macrodynamics. \
\>", "Text",
 CellChangeTimes->{
  4.0033465486697774`*^9},ExpressionUUID->"fb52140b-6155-4394-b406-\
dd641cc4fc52"],

Cell["\<\
Important: the strict RunNative.wls validator contains Exit[] and must be \
executed through WolframScript in a separate process, not inside this \
notebook. The guided file RunGuidedExperiment.wl is safe to run in this \
notebook.\
\>", "Text",ExpressionUUID->"756520fc-072c-4569-be36-f5128615e4bb"],

Cell[CellGroupData[{

Cell["1. Locate the extracted project folder", "Section",ExpressionUUID->"6e2dbcfd-c6f1-44f3-b0de-8986f1759e35"],

Cell["\<\
Choose the directory containing Kernel, Examples, Data, Results and \
README.md. Do not choose Kernel or Examples itself. Evaluating this cell \
creates the project variable.\
\>", "Text",
 CellChangeTimes->{
  4.0039865729415216`*^9},ExpressionUUID->"cffbc3ea-ba27-4dec-b961-\
2817f89a5be8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"project", " ", "=", " ", 
   RowBox[{"SystemDialogInput", "[", "\"\<Directory\>\"", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"StringQ", "[", "project", "]"}], ",", " ", 
   RowBox[{"DirectoryQ", "[", "project", "]"}], ",", " ", "project"}], 
  "}"}]}], "Input",ExpressionUUID->"d9b54576-d96c-4667-92e5-fab248ca083b"],

Cell["\<\
The first two values should be True. If selection was cancelled, rerun the \
cell. Check the source path next:\
\>", "Text",ExpressionUUID->"efde617b-3e7e-49e4-a577-18dd223624ab"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kernelFile", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
     "project", ",", " ", "\"\<Kernel\>\"", ",", " ", 
      "\"\<DynamicBarycentric.wl\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"FileExistsQ", "[", "kernelFile", "]"}]}], "Input",ExpressionUUID->\
"08719231-6725-4bb0-8a5b-4833ba24c2a6"],

Cell["\<\
Expected output: True. If False, select the inner extracted folder containing \
Kernel.\
\>", "Text",
 CellChangeTimes->{{4.003986819111*^9, 
  4.0039868216145525`*^9}},ExpressionUUID->"720c6fa5-e805-47e1-8348-\
d6e0c58631ee"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Load the Wolfram Language package", "Section",ExpressionUUID->"2270868f-739a-4f51-ac9d-e1514b1118ea"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Get", "[", "kernelFile", "]"}], ";"}], "\n", 
 RowBox[{"Names", "[", "\"\<DynamicBarycentric`*\>\"", "]"}]}], "Input",Expres\
sionUUID->"c0cb6f7a-6dcd-4154-ac33-ebbe6477a3cf"],

Cell["\<\
The result should list DBAllStates, DBStep, DBOrbitRepresentatives, \
DBSelectedObserver and other public functions. A Null result from Get itself \
is normal.\
\>", "Text",ExpressionUUID->"990ac663-392e-4f1d-82cc-de305e72c4d1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Enumerate the finite microscopic state spaces", "Section",ExpressionUUID->"1d83bd66-3596-4183-81d0-78fa3e8ee5ad"],

Cell["\<\
Four vertices with binary states produce 2^4 vertex labelings. Six possible \
graph edges produce 2^6 edge configurations; hence 1024 combined states. In \
the 3-uniform model there are four possible hyperedges, hence 256 combined \
states.\
\>", "Text",
 CellChangeTimes->{{4.0039866144953923`*^9, 
  4.003986614695465*^9}},ExpressionUUID->"6ffd851d-a1dd-4004-8511-\
b77c14ead587"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"DynamicBarycentric`DBAllStates", "[", "2", "]"}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"Length", "[", 
    RowBox[{"DynamicBarycentric`DBAllStates", "[", "3", "]"}], "]"}]}], 
  "}"}]], "Input",ExpressionUUID->"11aac063-a435-42a3-ad28-6223ca47090a"],

Cell["Expected output: {1024, 256}.", "Text",
 CellChangeTimes->{{4.003986621664114*^9, 
  4.0039866223591766`*^9}},ExpressionUUID->"f2a09e3d-c964-4996-8a75-\
02d92e625232"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Identify states up to graph isomorphism", "Section",ExpressionUUID->"2d07f976-feca-4abf-b020-aa1336b16c3d"],

Cell["\<\
Vertex relabeling by the 24 elements of S4 defines equivalence classes of \
decorated states. The finite enumerator uses canonical representatives of \
these classes.\
\>", "Text",ExpressionUUID->"ee75fe59-7f72-4aef-af54-565c1a01c840"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"graphReps", " ", "=", " ", 
   RowBox[{"DynamicBarycentric`DBOrbitRepresentatives", "[", "2", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"hyperReps", " ", "=", " ", 
   RowBox[{"DynamicBarycentric`DBOrbitRepresentatives", "[", "3", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "graphReps", "]"}], ",", " ", 
   RowBox[{"Length", "[", "hyperReps", "]"}]}], "}"}]}], "Input",ExpressionUUI\
D->"0c3618a3-fd81-4bb0-b35d-9ddb9fb1d7bd"],

Cell["Expected output: {90, 35}.", "Text",
 CellChangeTimes->{{4.003986635186737*^9, 
  4.0039866361010017`*^9}},ExpressionUUID->"ef130482-01bc-45a0-be59-\
9a1176832437"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Construct motif-based observers", "Section",ExpressionUUID->"712a7792-32f3-491d-954b-b57b8ab79424"],

Cell["\<\
The selected observer consists of all induced colored motifs through two \
vertices and five selected three-vertex motifs. The output is a 13-component \
vector. Multiple microscopic orbits can have the same observed vector.\
\>", "Text",ExpressionUUID->"2b2c3d45-9660-4877-b298-2d10035cd475"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "observer", " ", "=", " ", "DynamicBarycentric`DBSelectedObserver"}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"observer", "[", 
     RowBox[{"First", "[", "graphReps", "]"}], "]"}], "]"}], ",", "\n", " ", 
   RowBox[{"Length", "[", 
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{"observer", " ", "/@", " ", "graphReps"}], "]"}], "]"}]}], 
  "}"}]}], "Input",ExpressionUUID->"18cffdb0-5482-4265-9f36-fca214a88723"],

Cell["\<\
Expected output: {13, 86}. Compare with the complete three-vertex motif \
census, which distinguishes all 90 isomorphism classes.\
\>", "Text",
 CellChangeTimes->{{4.0039866812229366`*^9, 
  4.003986681874566*^9}},ExpressionUUID->"985d594d-0bdf-4bf9-a446-\
f6d31b8577e7"],

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"DeleteDuplicates", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"DynamicBarycentric`DBMotifCensus", "[", 
       RowBox[{"#", ",", "3"}], "]"}], "&"}], ")"}], " ", "/@", " ", 
    "graphReps"}], "]"}], "]"}]], "Input",ExpressionUUID->"94f86531-c590-4b11-\
a8b9-b9834df784fe"],

Cell["Expected output: 90.", "Text",
 CellChangeTimes->{{4.0039866944242773`*^9, 
  4.0039866950347366`*^9}},ExpressionUUID->"0754fbff-6e91-4e49-bc6c-\
f1799cb71325"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Certify exact observable evolution", "Section",ExpressionUUID->"fe05b5d3-2366-4b47-85ef-0d48bd1a76fc"],

Cell["\<\
The mathematical condition is: q(x)=q(y) => q(F(x))=q(F(y)). This allows a \
well-defined induced update on the observed states. The test compares \
successors of every microscopic orbit representative.\
\>", "Text",
 CellChangeTimes->{{4.0039867023960238`*^9, 
  4.003986707237075*^9}},ExpressionUUID->"7c429346-ea2d-479a-bff8-\
626914c49b5d"],

Cell[BoxData[
 RowBox[{"{", "\n", " ", 
  RowBox[{
   RowBox[{"DynamicBarycentric`DBMacroExactQ", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"st", ",", 
       RowBox[{"DynamicBarycentric`DBMotifCensus", "[", 
        RowBox[{"st", ",", "2"}], "]"}]}], "]"}], ",", "2"}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"DynamicBarycentric`DBMacroExactQ", "[", 
    RowBox[{"observer", ",", "2"}], "]"}], ",", "\n", " ", 
   RowBox[{"DynamicBarycentric`DBMacroExactQ", "[", 
    RowBox[{
    "observer", ",", "2", ",", "DynamicBarycentric`DBStepComplement"}], 
    "]"}]}], "\n", "}"}]], "Input",ExpressionUUID->"dbc3cba8-cf90-4b1a-8779-\
9125500e5610"],

Cell["\<\
Expected output: {False, True, True}. Two-vertex motifs alone are \
insufficient. The selected observer works for both the original interacting \
update and the complement-composed variant.\
\>", "Text",
 CellChangeTimes->{{4.003986716430434*^9, 
  4.00398672472503*^9}},ExpressionUUID->"f7ebb5b5-a959-47dd-b479-\
d7e1c1075500"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Examine changing automorphism groups", "Section",ExpressionUUID->"f9548a82-0628-40ae-9e7a-1bb99bd6b0d1"],

Cell["\<\
The uncolored graph automorphism orders can decrease or increase. By \
contrast, decorated-state stabilizers of a deterministic \
permutation-equivariant update cannot decrease.\
\>", "Text",ExpressionUUID->"b8db4959-3ed2-498b-9409-b7103259fde9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"init", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Arity\>\"", "->", "2"}], ",", 
     RowBox[{"\"\<Edges\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "0", ",", "0", ",", "0"}], 
       "}"}]}], ",", 
     RowBox[{"\"\<Colors\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "0", ",", "0"}], "}"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"traj", " ", "=", " ", 
   RowBox[{"DynamicBarycentric`DBOrbitTrajectory", "[", 
    RowBox[{"init", ",", "5"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"DynamicBarycentric`DBAutomorphismOrder", "[", 
      RowBox[{"#", ",", "False"}], "]"}], "&"}], " ", "/@", " ", "traj"}], 
   ",", "\n", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"DynamicBarycentric`DBAutomorphismOrder", "[", 
      RowBox[{"#", ",", "True"}], "]"}], "&"}], " ", "/@", " ", "traj"}]}], 
  "}"}]}], "Input",ExpressionUUID->"ad28c4dd-f0f4-4558-9fa9-e3d4bd60fd22"],

Cell["\<\
The first list should begin with 6,8,24,8. The second should be nondecreasing.\
\>", "Text",ExpressionUUID->"b403cb29-5678-47a0-ba21-eee72cd8ee43"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Compute a nontrivial observer collision", "Section",ExpressionUUID->"f4ea40fd-902f-446e-b1eb-083d57debbb2"],

Cell["\<\
Here we find different microscopic isomorphism classes that share the same \
observation, but whose common observable class evolves nontrivially under \
complement-composed dynamics.\
\>", "Text",ExpressionUUID->"1c7f6ceb-ecce-4e6d-8efd-0cd387bea539"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"merged", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"GatherBy", "[", 
      RowBox[{"graphReps", ",", "observer"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"active", " ", "=", " ", 
   RowBox[{"SelectFirst", "[", 
    RowBox[{"merged", ",", "\n", "  ", 
     RowBox[{"Function", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{
        RowBox[{"observer", "[", 
         RowBox[{"DynamicBarycentric`DBStepComplement", "[", 
          RowBox[{"First", "[", "g", "]"}], "]"}], "]"}], " ", "=!=", " ", 
        RowBox[{"observer", "[", 
         RowBox[{"First", "[", "g", "]"}], "]"}]}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"MissingQ", "[", "active", "]"}], ",", " ", 
   "\"\<No moving merged block found\>\"", ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "active", "]"}], ",", 
     RowBox[{"observer", "[", 
      RowBox[{"First", "[", "active", "]"}], "]"}], ",", "\n", "  ", 
     RowBox[{"observer", "[", 
      RowBox[{"DynamicBarycentric`DBStepComplement", "[", 
       RowBox[{"First", "[", "active", "]"}], "]"}], "]"}]}], "}"}]}], 
  "]"}]}], "Input",ExpressionUUID->"7a871602-ea0a-4a61-9556-34fe02c7a9f3"],

Cell["\<\
Expected output: a nonempty witness block and different current/next \
observation vectors. The equality of next observations across the entire \
fiber follows from exactness, tested in Step 6.\
\>", "Text",
 CellChangeTimes->{{4.0039867897135353`*^9, 
  4.0039867904086556`*^9}},ExpressionUUID->"3cd44919-fb67-4b5b-a3d1-\
fe197f909214"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Link the observer to positional number encoding", "Section",ExpressionUUID->"b1a73ac2-73bc-4e8b-9185-e76207d02fc0"],

Cell["\<\
All thirteen motif counts lie between 0 and 6. Encoding them in base seven is \
injective on the observed values, without reconstructing lost microscopic \
information.\
\>", "Text",ExpressionUUID->"28d094c1-600c-441f-90f1-93a2ce791802"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"codes", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{
    "DynamicBarycentric`DBSignatureCode", " ", "/@", " ", "graphReps"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "codes", "]"}], ",", " ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{"codes", ",", "IntegerQ"}], "]"}]}], "}"}]}], "Input",ExpressionUU\
ID->"c475a880-013b-42c1-b110-ed5f202414c6"],

Cell["Expected output: {86, True}.", "Text",
 CellChangeTimes->{{4.003986812025395*^9, 
  4.003986812709588*^9}},ExpressionUUID->"d8f4b68d-fc3f-4dad-86cb-\
c9673461e036"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Open the interactive Mathematica simulator", "Section",ExpressionUUID->"18602ee4-84bc-4952-8be0-67ee93737b91"],

Cell["\<\
This code returns a Manipulate interface with a slider over rewriting steps. \
Run it inside the graphical Mathematica notebook interface.\
\>", "Text",ExpressionUUID->"35555091-ce7d-4d56-9a69-03d0040eb30f"],

Cell[BoxData[
 RowBox[{"Get", "[", 
  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", 
    RowBox[{
    "project", ",", "\"\<Examples\>\"", ",", 
     "\"\<InteractiveSimulator.wl\>\""}], "}"}], "]"}], "]"}]], "Input",Expres\
sionUUID->"9174533a-befc-4cbd-a7a7-a7dba781dfda"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11. Generate the native trajectory figure", "Section",ExpressionUUID->"698f11cb-c605-4ac9-a4a4-1f9125e4ae4a"],

Cell["\<\
The figure generator exports Results/wolfram_trajectory.png. It can be \
evaluated within Mathematica because it does not invoke Exit[].\
\>", "Text",ExpressionUUID->"3020ecbf-da51-48ef-9e8d-56c4af13a783"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
     "project", ",", "\"\<Examples\>\"", ",", "\"\<WolframVisuals.wls\>\""}], 
     "}"}], "]"}], "]"}], ";"}], "\n", 
 RowBox[{"Import", "[", 
  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", 
    RowBox[{
    "project", ",", "\"\<Results\>\"", ",", 
     "\"\<wolfram_trajectory.png\>\""}], "}"}], "]"}], "]"}]}], "Input",Expres\
sionUUID->"98e32d63-97be-423f-abe5-2ed3b65e0a25"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12. Run the full, commented guided script", "Section",ExpressionUUID->"b095f465-f71c-409f-a17f-70701d70c066"],

Cell["\<\
The companion .wl script runs the main checks in one sequence, provides \
pass/fail messages and exports Results/guided_native_run.json. It never \
intentionally calls Exit[].\
\>", "Text",ExpressionUUID->"dbe1bd3e-7c4c-4c89-8c4a-125e87adc28b"],

Cell[BoxData[
 RowBox[{"Get", "[", 
  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", 
    RowBox[{
    "project", ",", "\"\<Examples\>\"", ",", 
     "\"\<RunGuidedExperiment.wl\>\""}], "}"}], "]"}], "]"}]], "Input",Express\
ionUUID->"bc10e4ef-ab97-46ca-9845-4b94ae7b9f23"]
}, Open  ]],

Cell[CellGroupData[{

Cell["13. Full verification outside this notebook", "Section",
 CellChangeTimes->{{4.003986861269026*^9, 
  4.0039868628168344`*^9}},ExpressionUUID->"77f2767e-bb40-4d4f-b52f-\
b754e948ff78"],

Cell["\<\
Open PowerShell at the project root and run .\\run_native_verification.ps1. \
Alternatively use wolframscript -file Examples/RunNative.wls followed by \
python validation/verify_native.py. The latter script has explicit Exit[] \
failure codes and should be run in a separate process. A valid final native \
certificate requires both Wolfram execution and the independent Python \
comparison to succeed.\
\>", "Text",ExpressionUUID->"d6e9576c-867b-460a-8d8b-de485929bac9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Research status", "Section",ExpressionUUID->"02161df6-ae4c-4d0c-844a-1868b34a8b5d"],

Cell["\<\
The complete five-motif minimality search was conducted in the independent \
Python reference project and is not recomputed in the notebook. The project \
implements custom synchronous graph/hypergraph rules.\
\>", "Text",
 CellChangeTimes->{{4.0039869105476904`*^9, 
  4.0039869114466553`*^9}},ExpressionUUID->"ea3313fe-3d6f-4b30-9485-\
aaae65d91162"]
}, Open  ]]
}, Open  ]]
},
